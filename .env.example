# API of the telegram bot.
TG_BOT_API="telegram-bot-api"

# Payment requisites.

# Tron wallet address to accept payments to.
TRON_WALLET_ADDRESS="tron-address"

# Tron token smartcontract to accept payments in.
TRON_TOKEN_SMARTCONTRACT="tron-token-smartcontract"

# Tron API key.
TRONGRID_API_KEY="api-key-of-trongrid"

# External service address.
SERVICE_ADDRESS="address-of-the-main-service (optional)"

# PostgreSQL.
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="db-name"
POSTGRES_HOST="localhost or other host"
POSTGRES_PORT="5432 (default) or any other custom port"

# Server credentials
SERVER_IP="server-ip-to-deploy-the-service-to"
SERVER_USER="server-username"
SERVER_PROJECT_PATH="/path/to/project"
SERVER_SSH_PORT="ssh-custom-port"

# Credentials of support.
SUPPORT_CREDENTIALS="@your-service-custom-support-tg-tag"